# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
!.env.example

# ============================================================
# PYTHON / FASTAPI BACKEND
# ============================================================

# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python packaging
*.egg
*.egg-info/
dist/
build/
develop-eggs/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting caches
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ============================================================
# DATABASE
# ============================================================

# Local SQLite databases
*.db
*.sqlite
*.sqlite3

# ============================================================
# USER UPLOADS / GENERATED FILES
# ============================================================

backend/uploads/*
backend/uploads/**

# Keep the uploads directory itself if needed
!backend/uploads/.gitkeep

# Generated files
backend/logs/
backend/*.log
*.log

# ============================================================
# NODE / REACT / VITE FRONTEND
# ============================================================

frontend/node_modules/

# Vite build output
frontend/dist/
frontend/build/

# Vite local environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

